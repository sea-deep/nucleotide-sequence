{
  "name": "nucleotide-sequence",
  "version": "1.0.2",
  "description": "A lightweight and modern bioinformatics toolkit library for Node and the browser",
  "main": "./dist/nucleotide-sequence.umd.cjs",
  "module": "./dist/nucleotide-sequence.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sea-deep/nucleotide-sequence.git"
  },
  "bugs": {
    "url": "https://github.com/sea-deep/nucleotide-sequence/issues"
  },
  "homepage": "https://github.com/sea-deep/nucleotide-sequence#readme",
  "exports": {
    ".": {
      "import": "./dist/nucleotide-sequence.js",
      "require": "./dist/nucleotide-sequence.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "bioinformatics",
    "sequence",
    "dna",
    "rna",
    "alignment"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
